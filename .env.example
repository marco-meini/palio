# Copia in .env (dev) o .env.production (VPS). Stesse variabili ovunque.
#   cp .env.example .env

# --- Database (obbligatorio) ---
DATABASE_URL=postgresql://app_palio:password@127.0.0.1:5432/palio

# Chat/MCP read-only (consigliato in prod: utente palio_chat_ro)
# Se omesso, il chat usa DATABASE_URL con un warning.
CHAT_DATABASE_URL=

# --- Anthropic (obbligatorio per la chat) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_MAX_TOOL_STEPS=12
ANTHROPIC_MAX_REGOLAMENTO_CALLS=2
ANTHROPIC_MAX_TOOL_RESULT_CHARS=6000
ANTHROPIC_MAX_HISTORY_MESSAGES=10
ANTHROPIC_MAX_MESSAGE_CHARS=4000
ANTHROPIC_COMPACT_TOOL_RESULTS=true
ANTHROPIC_MAX_TOOL_RESULT_ROWS=50

# --- API HTTP ---
SERVER_PORT=3001
# Lista CSV di origin (Angular + Expo Web)
CORS_ORIGIN=http://localhost:4200,http://localhost:8081
NODE_ENV=development

# --- Auth Google OAuth ---
AUTH_ENABLED=false
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PUBLIC_API_URL=http://localhost:3001
AUTH_PUBLIC_APP_URL=http://localhost:4200
AUTH_MOBILE_REDIRECT_URI=dimmelo://auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternativa al client id/secret inline:
GOOGLE_OAUTH_JSON_PATH=

# --- Regolamento RAG ---
REGOLAMENTO_TOP_K=8
REGOLAMENTO_MIN_SCORE=0.35

# --- Postgres skill CLI (solo fallback se pg driver non disponibile) ---
POSTGRES_CLI=
DB_PROJECT_ROOT=
DB_PROFILE=local
