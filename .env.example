# Copia in .env (dev) o .env.production (VPS). Stesse variabili ovunque.
#   cp .env.example .env

# --- Database (obbligatorio) ---
DATABASE_URL=postgresql://app_palio:password@127.0.0.1:5432/palio

# Chat/MCP read-only (consigliato in prod: utente palio_chat_ro)
# Se omesso, il chat usa DATABASE_URL con un warning.
CHAT_DATABASE_URL=

# --- Anthropic (obbligatorio per la chat) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Modello per il titolo delle chat salvate (facoltativo: default ANTHROPIC_MODEL)
ANTHROPIC_TITLE_MODEL=
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_MAX_TOOL_STEPS=12
ANTHROPIC_MAX_REGOLAMENTO_CALLS=2
ANTHROPIC_MAX_TOOL_RESULT_CHARS=6000
ANTHROPIC_MAX_HISTORY_MESSAGES=10
ANTHROPIC_MAX_MESSAGE_CHARS=4000
ANTHROPIC_COMPACT_TOOL_RESULTS=true
ANTHROPIC_MAX_TOOL_RESULT_ROWS=50

# --- API HTTP ---
SERVER_PORT=3001
NODE_ENV=development

# --- Autenticazione (OIDC con ZITADEL; vedi README) ---
# URL pubblico dell'app (origin del frontend). Dev: http://localhost:4200  Prod: https://<dominio>
APP_URL=http://localhost:4200
# Segreto per firmare i cookie (stato del login, cifratura dei refresh token; >= 32 caratteri).
# Generare con: openssl rand -base64 48
COOKIE_SECRET=
# URL pubblico di ZITADEL (issuer OIDC). Es. https://id.<dominio>
ZITADEL_URL=https://id.example.com
# Progetto ZITADEL di Dimmelo: i suoi ruoli sono i permessi (chat.use, users.view, users.manage)
ZITADEL_PROJECT_ID=
# Applicazione web del progetto (tipo Web, autenticazione Basic). Il secret resta solo nel backend.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Token (PAT) del service account di palio su ZITADEL, per la pagina Utenti (inviti e ruoli).
# Resta solo nel backend.
ZITADEL_TOKEN=
# Organizzazione ZITADEL di Dimmelo (obbligatoria): utenti, progetto e service account stanno lì;
# il login e la ricerca per email restano dentro questa organizzazione
ZITADEL_ORG_ID=
# true quando sul server c'è il nuovo login di ZITADEL (Login V2, /ui/v2/login): i link d'invito
# usano la sua pagina passkey, che non chiede il nome del dispositivo
ZITADEL_LOGIN_V2=false
# Email d'invito (SMTP, es. Brevo: utente …@smtp-brevo.com e una SMTP key). Senza SMTP_HOST
# gli inviti restano solo link da copiare. Porta 587 con SMTP_SECURE=false (STARTTLS), 465 con true.
# MAIL_FROM deve essere un mittente (o dominio) verificato sul provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dimmelo <noreply@example.com>"
# Durata sessione (giorni): massima e per inattività
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# --- Regolamento RAG ---
REGOLAMENTO_TOP_K=8
REGOLAMENTO_MIN_SCORE=0.35

# --- Postgres skill CLI (solo fallback se pg driver non disponibile) ---
POSTGRES_CLI=
DB_PROJECT_ROOT=
DB_PROFILE=local
