# Produzione (VPS). Copia in .env.production — stesse chiavi di .env.example.
#   cp .env.example .env.production
#
# DATABASE_URL: host "postgres" = container sulla rete Docker omonima.

DATABASE_URL=postgresql://app_palio:CHANGE_ME@postgres:5432/palio
CHAT_DATABASE_URL=postgresql://palio_chat_ro:CHANGE_ME@postgres:5432/palio

NODE_ENV=production

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

SERVER_PORT=3001

# --- Autenticazione (passkey con ZITADEL, come dimora; vedi README) ---
# URL pubblico dell'app (origin del frontend). Dev: http://localhost:4200  Prod: https://<dominio>
APP_URL=https://dimmelo.marcomeini.it
# Segreto per firmare i cookie del login (>= 32 caratteri). Generare con: openssl rand -base64 48
COOKIE_SECRET=
# URL pubblico di ZITADEL. Dev: http://localhost:8081 (ZITADEL locale di dimora)  Prod: https://id.<dominio>
ZITADEL_URL=https://id.marcomeini.it
# Token (PAT) del service account di palio su ZITADEL (vedi README). Poteri da amministratore:
# resta solo nel backend.
ZITADEL_TOKEN=
# Organizzazione ZITADEL in cui creare gli utenti (facoltativo: default quella del service account)
ZITADEL_ORG_ID=
# Dominio delle passkey (facoltativo: default l'host di APP_URL). Per condividere le passkey tra
# app su sottodomini diversi usare il dominio padre, uguale per tutte (es. example.com).
PASSKEY_RP_ID=
# Durata dei link d'invito, in ore (max 744)
INVITE_TTL_HOURS=72
# Durata dei link di recupero accesso inviati per email ("Non riesci ad accedere?"), in minuti
RECOVERY_TTL_MINUTES=60
# Durata sessione (giorni): massima e per inattività
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# --- Email (SMTP) per il recupero dell'accesso ---
# Senza SMTP_HOST le email non partono (in sviluppo il testo finisce nel log dell'API).
SMTP_HOST=
# 587 = STARTTLS, 465 = TLS diretto (SMTP_SECURE=true di default su 465)
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Mittente, es. Dimmelo <dimmelo@example.com>
SMTP_FROM=

REGOLAMENTO_TOP_K=8
REGOLAMENTO_MIN_SCORE=0.35
