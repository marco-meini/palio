# Produzione (VPS). Copia in .env.production — stesse chiavi di .env.example.
#   cp .env.example .env.production
#
# DATABASE_URL: host "postgres" = container sulla rete Docker omonima.

DATABASE_URL=postgresql://app_palio:CHANGE_ME@postgres:5432/palio
CHAT_DATABASE_URL=postgresql://palio_chat_ro:CHANGE_ME@postgres:5432/palio

NODE_ENV=production

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

SERVER_PORT=3001
CORS_ORIGIN=https://dimmelo.marcomeini.it

AUTH_ENABLED=true
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PUBLIC_APP_URL=https://dimmelo.marcomeini.it
AUTH_PUBLIC_API_URL=https://dimmelo.marcomeini.it

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_JSON_PATH=/run/secrets/google-oauth.json

REGOLAMENTO_TOP_K=8
REGOLAMENTO_MIN_SCORE=0.35
