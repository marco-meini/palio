# Copia in .env.production (non versionato) sul VPS.
# DATABASE_URL: host "postgres" = nome container sulla rete Docker omonima.

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/palio
NODE_ENV=production

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

SERVER_PORT=3001
CORS_ORIGIN=https://dimmelo.marcomeini.it

AUTH_ENABLED=true
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PUBLIC_APP_URL=https://dimmelo.marcomeini.it
AUTH_PUBLIC_API_URL=https://dimmelo.marcomeini.it

# Oppure GOOGLE_OAUTH_JSON_PATH=/run/secrets/google-oauth.json nel compose
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
