# Produzione (VPS). Copia in .env.production — stesse chiavi di .env.example.
#   cp .env.example .env.production
#
# DATABASE_URL: host "postgres" = container sulla rete Docker omonima.

DATABASE_URL=postgresql://app_palio:CHANGE_ME@postgres:5432/palio
CHAT_DATABASE_URL=postgresql://palio_chat_ro:CHANGE_ME@postgres:5432/palio

NODE_ENV=production

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

SERVER_PORT=3001

# --- Autenticazione (OIDC con ZITADEL; vedi README) ---
# URL pubblico dell'app (origin del frontend). Dev: http://localhost:4200  Prod: https://<dominio>
APP_URL=https://dimmelo.marcomeini.it
# Segreto per firmare i cookie (stato del login, cifratura dei refresh token; >= 32 caratteri).
# Generare con: openssl rand -base64 48
COOKIE_SECRET=
# URL pubblico di ZITADEL (issuer OIDC). Es. https://id.<dominio>
ZITADEL_URL=https://id.marcomeini.it
# Progetto ZITADEL di Dimmelo: i suoi ruoli sono i permessi (chat.use, users.view, users.manage)
ZITADEL_PROJECT_ID=401193656905629698
# Applicazione web del progetto (tipo Web, autenticazione Basic). Il secret resta solo nel backend.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Token (PAT) del service account di palio su ZITADEL, per la pagina Utenti (inviti e ruoli).
# Resta solo nel backend.
ZITADEL_TOKEN=
# Organizzazione ZITADEL in cui creare gli utenti (facoltativo: default quella del service account)
ZITADEL_ORG_ID=
# Durata sessione (giorni): massima e per inattività
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

REGOLAMENTO_TOP_K=8
REGOLAMENTO_MIN_SCORE=0.35
